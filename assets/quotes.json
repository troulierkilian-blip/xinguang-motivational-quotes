[
  {
    "id": "perseverance_01",
    "text": "慢一点也没关系，只要你还在朝着想去的地方走。",
    "theme": "perseverance"
  },
  {
    "id": "perseverance_02",
    "text": "今天多坚持的一小步，会成为明天更稳的底气。",
    "theme": "perseverance"
  },
  {
    "id": "perseverance_03",
    "text": "山路不会因为陡峭而消失，你的脚步也值得继续。",
    "theme": "perseverance"
  },
  {
    "id": "perseverance_04",
    "text": "把目光放在下一步，远方会在行走中慢慢靠近。",
    "theme": "perseverance"
  },
  {
    "id": "perseverance_05",
    "text": "没有掌声的日子，也可以认真把自己的事做好。",
    "theme": "perseverance"
  },
  {
    "id": "perseverance_06",
    "text": "进步有时很安静，却一直藏在你没有放弃的练习里。",
    "theme": "perseverance"
  },
  {
    "id": "perseverance_07",
    "text": "累了就停下来歇一会儿，休息之后仍然可以出发。",
    "theme": "perseverance"
  },
  {
    "id": "perseverance_08",
    "text": "别急着否定缓慢的自己，扎根本来就需要时间。",
    "theme": "perseverance"
  },
  {
    "id": "perseverance_09",
    "text": "反复尝试的过程，正在让你更懂得如何前行。",
    "theme": "perseverance"
  },
  {
    "id": "perseverance_10",
    "text": "当结果还没有出现，先珍惜自己已经付出的认真。",
    "theme": "perseverance"
  },
  {
    "id": "perseverance_11",
    "text": "你走过的每一段路，都在悄悄增加脚下的力量。",
    "theme": "perseverance"
  },
  {
    "id": "perseverance_12",
    "text": "困难的这一天，未必能定义你接下来的日子。",
    "theme": "perseverance"
  },
  {
    "id": "perseverance_13",
    "text": "把大目标拆成小步，今天就会多一点可走的路。",
    "theme": "perseverance"
  },
  {
    "id": "perseverance_14",
    "text": "不用一口气翻过整座山，先登上眼前这一段坡。",
    "theme": "perseverance"
  },
  {
    "id": "perseverance_15",
    "text": "坚持不是从不疲惫，而是学会照顾自己后再继续。",
    "theme": "perseverance"
  },
  {
    "id": "perseverance_16",
    "text": "暂时看不到变化的时候，也请给积累一点耐心。",
    "theme": "perseverance"
  },
  {
    "id": "perseverance_17",
    "text": "愿你在重复的日常里，仍能找到愿意继续的理由。",
    "theme": "perseverance"
  },
  {
    "id": "perseverance_18",
    "text": "完成一件小事，也是在替自己的未来铺一块石头。",
    "theme": "perseverance"
  },
  {
    "id": "perseverance_19",
    "text": "把今天的练习做好，比反复担忧终点更有力量。",
    "theme": "perseverance"
  },
  {
    "id": "perseverance_20",
    "text": "一次没有做到，不妨换个方法，再给自己一次机会。",
    "theme": "perseverance"
  },
  {
    "id": "perseverance_21",
    "text": "你的节奏可以很慢，你的方向依然可以很坚定。",
    "theme": "perseverance"
  },
  {
    "id": "perseverance_22",
    "text": "走过低谷的人，也有机会在下一段路遇见阳光。",
    "theme": "perseverance"
  },
  {
    "id": "perseverance_23",
    "text": "不要只看还差多远，也看看自己已经走了多远。",
    "theme": "perseverance"
  },
  {
    "id": "perseverance_24",
    "text": "每天留一点力气给梦想，它便有了继续生长的空间。",
    "theme": "perseverance"
  },
  {
    "id": "perseverance_25",
    "text": "允许计划调整，也允许自己始终认真地靠近目标。",
    "theme": "perseverance"
  },
  {
    "id": "perseverance_26",
    "text": "在想放弃之前，先问问自己是否需要一场好好的休息。",
    "theme": "perseverance"
  },
  {
    "id": "perseverance_27",
    "text": "那些认真做过的尝试，会成为你下一次出发的经验。",
    "theme": "perseverance"
  },
  {
    "id": "perseverance_28",
    "text": "把难熬的一段拆成今天，让坚持变得可以触碰。",
    "theme": "perseverance"
  },
  {
    "id": "perseverance_29",
    "text": "慢慢来，你正在学会用更适合自己的方式走这条路。",
    "theme": "perseverance"
  },
  {
    "id": "perseverance_30",
    "text": "愿你带着耐心前行，也带着温柔看待一路上的自己。",
    "theme": "perseverance"
  },
  {
    "id": "courage_01",
    "text": "勇气可以很小，小到今天愿意再试一次。",
    "theme": "courage"
  },
  {
    "id": "courage_02",
    "text": "你不必等到毫无畏惧，才允许自己迈出第一步。",
    "theme": "courage"
  },
  {
    "id": "courage_03",
    "text": "面对未知时，先把能够准备的那一部分准备好。",
    "theme": "courage"
  },
  {
    "id": "courage_04",
    "text": "说出自己的想法，也是一种值得珍惜的勇敢。",
    "theme": "courage"
  },
  {
    "id": "courage_05",
    "text": "尝试的意义，有时就在于让你更清楚自己的可能。",
    "theme": "courage"
  },
  {
    "id": "courage_06",
    "text": "当心里有些害怕，可以带着它一起向前走。",
    "theme": "courage"
  },
  {
    "id": "courage_07",
    "text": "选择适合自己的路，需要勇气，也值得尊重。",
    "theme": "courage"
  },
  {
    "id": "courage_08",
    "text": "你可以不够熟练，仍然有资格开始练习。",
    "theme": "courage"
  },
  {
    "id": "courage_09",
    "text": "把不敢做的事缩小一点，试着从能够做到的部分开始。",
    "theme": "courage"
  },
  {
    "id": "courage_10",
    "text": "拒绝不适合自己的要求，也是在守护内心的方向。",
    "theme": "courage"
  },
  {
    "id": "courage_11",
    "text": "一次尝试的结果，不会决定你全部的价值。",
    "theme": "courage"
  },
  {
    "id": "courage_12",
    "text": "向别人寻求帮助，也可以是一种勇敢的选择。",
    "theme": "courage"
  },
  {
    "id": "courage_13",
    "text": "别让过去的一次失利，替你决定今天能否出发。",
    "theme": "courage"
  },
  {
    "id": "courage_14",
    "text": "改变不必声势浩大，一次诚实的选择就可以成为起点。",
    "theme": "courage"
  },
  {
    "id": "courage_15",
    "text": "你可以先走一小段，再决定接下来怎样前行。",
    "theme": "courage"
  },
  {
    "id": "courage_16",
    "text": "敢于承认不知道，是走向学会的第一步。",
    "theme": "courage"
  },
  {
    "id": "courage_17",
    "text": "在重要的事情面前，给自己的声音留一个位置。",
    "theme": "courage"
  },
  {
    "id": "courage_18",
    "text": "走出熟悉的范围时，也记得为自己准备可靠的支撑。",
    "theme": "courage"
  },
  {
    "id": "courage_19",
    "text": "你不需要像别人一样勇敢，找到自己的方式就好。",
    "theme": "courage"
  },
  {
    "id": "courage_20",
    "text": "面对新的机会，可以先了解，再给尝试留一点空间。",
    "theme": "courage"
  },
  {
    "id": "courage_21",
    "text": "有些门需要亲手推开，才知道里面是否适合自己。",
    "theme": "courage"
  },
  {
    "id": "courage_22",
    "text": "即使声音有些颤抖，你认真表达的心意仍然有分量。",
    "theme": "courage"
  },
  {
    "id": "courage_23",
    "text": "勇敢地调整方向，不代表之前的努力没有意义。",
    "theme": "courage"
  },
  {
    "id": "courage_24",
    "text": "愿你既敢于追求，也敢于说出自己的边界。",
    "theme": "courage"
  },
  {
    "id": "courage_25",
    "text": "一小次主动，可能让原本陌生的世界变得亲切一些。",
    "theme": "courage"
  },
  {
    "id": "courage_26",
    "text": "别急着要求自己无所不能，先鼓励那个愿意尝试的你。",
    "theme": "courage"
  },
  {
    "id": "courage_27",
    "text": "把担心写下来，把能做的事圈出来，然后走出一步。",
    "theme": "courage"
  },
  {
    "id": "courage_28",
    "text": "值得做的决定，也可以经过仔细思考后慢慢作出。",
    "theme": "courage"
  },
  {
    "id": "courage_29",
    "text": "让好奇心陪着你，走过尚不熟悉的那一段路。",
    "theme": "courage"
  },
  {
    "id": "courage_30",
    "text": "你可以在谨慎中前进，也可以在练习中积攒勇气。",
    "theme": "courage"
  },
  {
    "id": "hope_01",
    "text": "你不必一次看清整条路，先让脚下的这一步有光。",
    "theme": "hope"
  },
  {
    "id": "hope_02",
    "text": "今天的天空有些灰，也可以为明天留一点期待。",
    "theme": "hope"
  },
  {
    "id": "hope_03",
    "text": "日子可以从一件小小的好事开始重新变亮。",
    "theme": "hope"
  },
  {
    "id": "hope_04",
    "text": "请给自己留一扇窗，让新的可能慢慢走进来。",
    "theme": "hope"
  },
  {
    "id": "hope_05",
    "text": "眼前的一段阴影，不会替所有明天写下结论。",
    "theme": "hope"
  },
  {
    "id": "hope_06",
    "text": "当远方暂时模糊，就先照顾好今天的生活。",
    "theme": "hope"
  },
  {
    "id": "hope_07",
    "text": "愿你在平凡的一天里，也能遇见让心轻一点的瞬间。",
    "theme": "hope"
  },
  {
    "id": "hope_08",
    "text": "新的开始，有时只是一顿认真吃好的早餐。",
    "theme": "hope"
  },
  {
    "id": "hope_09",
    "text": "你已经走到这里，也仍然可以为下一步作新的选择。",
    "theme": "hope"
  },
  {
    "id": "hope_10",
    "text": "把期待放在能够做的小事上，今天便有了落脚点。",
    "theme": "hope"
  },
  {
    "id": "hope_11",
    "text": "也许转机还在路上，先给自己一点安稳和耐心。",
    "theme": "hope"
  },
  {
    "id": "hope_12",
    "text": "清晨的光提醒我们，生活可以有新的章节。",
    "theme": "hope"
  },
  {
    "id": "hope_13",
    "text": "不必急着看到完整的答案，先寻找一个可行的方向。",
    "theme": "hope"
  },
  {
    "id": "hope_14",
    "text": "给今天留一点空白，让意外的美好有地方停靠。",
    "theme": "hope"
  },
  {
    "id": "hope_15",
    "text": "愿你在等待的时候，也能照顾好自己的心情。",
    "theme": "hope"
  },
  {
    "id": "hope_16",
    "text": "过去的遗憾可以被记住，未来的可能也值得被看见。",
    "theme": "hope"
  },
  {
    "id": "hope_17",
    "text": "世界很大，眼前这一处困境不是你唯一的去向。",
    "theme": "hope"
  },
  {
    "id": "hope_18",
    "text": "把窗打开，深呼吸一次，再看看今天能做些什么。",
    "theme": "hope"
  },
  {
    "id": "hope_19",
    "text": "一个温柔的念头，也能让重新开始变得容易一点。",
    "theme": "hope"
  },
  {
    "id": "hope_20",
    "text": "在不确定的日子里，给自己一些确定的小小照顾。",
    "theme": "hope"
  },
  {
    "id": "hope_21",
    "text": "愿你能看见微弱的光，也能允许自己慢慢走近它。",
    "theme": "hope"
  },
  {
    "id": "hope_22",
    "text": "今天不必完美，只要有一件值得珍惜的小事。",
    "theme": "hope"
  },
  {
    "id": "hope_23",
    "text": "你仍然可以学习新的东西，认识新的自己。",
    "theme": "hope"
  },
  {
    "id": "hope_24",
    "text": "哪怕现在只能整理好桌面，也是在为生活腾出空间。",
    "theme": "hope"
  },
  {
    "id": "hope_25",
    "text": "对明天的期待，可以从今天的一次行动开始。",
    "theme": "hope"
  },
  {
    "id": "hope_26",
    "text": "你可以一边接受现实，一边为改变保留位置。",
    "theme": "hope"
  },
  {
    "id": "hope_27",
    "text": "当心情低落时，试着让一件简单的小事陪你度过今天。",
    "theme": "hope"
  },
  {
    "id": "hope_28",
    "text": "生命中的亮色，有时来自一句真诚的话和一次短暂的散步。",
    "theme": "hope"
  },
  {
    "id": "hope_29",
    "text": "把这一天过得温柔一点，也是朝希望走近一点。",
    "theme": "hope"
  },
  {
    "id": "hope_30",
    "text": "愿下一次抬头时，你能发现值得继续的那束光。",
    "theme": "hope"
  },
  {
    "id": "growth_01",
    "text": "成长不总是跑得更快，也可以是更懂得照顾自己。",
    "theme": "growth"
  },
  {
    "id": "growth_02",
    "text": "今天学会的一点点，正在扩展明天能够选择的路。",
    "theme": "growth"
  },
  {
    "id": "growth_03",
    "text": "允许自己经历生疏，熟练往往从这里慢慢开始。",
    "theme": "growth"
  },
  {
    "id": "growth_04",
    "text": "把一次失误当作线索，你会更清楚下一步怎样改进。",
    "theme": "growth"
  },
  {
    "id": "growth_05",
    "text": "不必和别人同时开花，先认真长好自己的根。",
    "theme": "growth"
  },
  {
    "id": "growth_06",
    "text": "变化可能还很细小，但你愿意学习的心已经在向前。",
    "theme": "growth"
  },
  {
    "id": "growth_07",
    "text": "比起责怪自己，不妨问一句这次能学到什么。",
    "theme": "growth"
  },
  {
    "id": "growth_08",
    "text": "每一次认真复盘，都在为下一次尝试积攒经验。",
    "theme": "growth"
  },
  {
    "id": "growth_09",
    "text": "你可以更新自己的想法，也可以重新认识自己的需要。",
    "theme": "growth"
  },
  {
    "id": "growth_10",
    "text": "把不会的部分留下来练习，把已经会的部分交给自己。",
    "theme": "growth"
  },
  {
    "id": "growth_11",
    "text": "成长有时意味着，学会把不属于自己的压力放下来。",
    "theme": "growth"
  },
  {
    "id": "growth_12",
    "text": "给新的习惯一点时间，也给旧的自己一点理解。",
    "theme": "growth"
  },
  {
    "id": "growth_13",
    "text": "昨天的方法不再适合时，今天可以尝试新的路径。",
    "theme": "growth"
  },
  {
    "id": "growth_14",
    "text": "愿你始终保留好奇，也保留重新学习的耐心。",
    "theme": "growth"
  },
  {
    "id": "growth_15",
    "text": "一页读懂的书，一次想清的问题，都算向前。",
    "theme": "growth"
  },
  {
    "id": "growth_16",
    "text": "不必把成长变成竞赛，找到能持续的节奏更重要。",
    "theme": "growth"
  },
  {
    "id": "growth_17",
    "text": "认真记录小小的进步，让变化有机会被你看见。",
    "theme": "growth"
  },
  {
    "id": "growth_18",
    "text": "你正在经历的练习，也会教你如何更好地练习。",
    "theme": "growth"
  },
  {
    "id": "growth_19",
    "text": "能够承认自己的局限，也是认识自己的进步。",
    "theme": "growth"
  },
  {
    "id": "growth_20",
    "text": "学会休息和求助，同样属于成长的一部分。",
    "theme": "growth"
  },
  {
    "id": "growth_21",
    "text": "新的能力可以从十分钟的专心练习开始。",
    "theme": "growth"
  },
  {
    "id": "growth_22",
    "text": "把比较换成观察，看看今天的你多懂了什么。",
    "theme": "growth"
  },
  {
    "id": "growth_23",
    "text": "允许自己改正，也允许自己在改正后继续前行。",
    "theme": "growth"
  },
  {
    "id": "growth_24",
    "text": "经验不只来自顺利，也来自认真处理过的难题。",
    "theme": "growth"
  },
  {
    "id": "growth_25",
    "text": "愿你既有向上生长的愿望，也有向下扎根的耐心。",
    "theme": "growth"
  },
  {
    "id": "growth_26",
    "text": "遇到不懂的地方，先问一个具体的问题。",
    "theme": "growth"
  },
  {
    "id": "growth_27",
    "text": "学到的东西不必立刻证明价值，它们也可以慢慢沉淀。",
    "theme": "growth"
  },
  {
    "id": "growth_28",
    "text": "当你更清楚自己需要什么，选择就可能更从容。",
    "theme": "growth"
  },
  {
    "id": "growth_29",
    "text": "一次细小的调整，也能让下一次尝试更接近目标。",
    "theme": "growth"
  },
  {
    "id": "growth_30",
    "text": "把今天当作一页新的练习，你仍然可以继续写下去。",
    "theme": "growth"
  },
  {
    "id": "focus_01",
    "text": "先把眼前这一件事做好，远方的纷乱可以稍后再想。",
    "theme": "focus"
  },
  {
    "id": "focus_02",
    "text": "给自己一段安静的时间，让注意力回到此刻。",
    "theme": "focus"
  },
  {
    "id": "focus_03",
    "text": "把目标缩小到接下来的十分钟，开始就会容易一些。",
    "theme": "focus"
  },
  {
    "id": "focus_04",
    "text": "当思绪走远时，温柔地把自己带回正在做的事。",
    "theme": "focus"
  },
  {
    "id": "focus_05",
    "text": "清晰的下一步，比反复想象整段路更能帮助现在的你。",
    "theme": "focus"
  },
  {
    "id": "focus_06",
    "text": "今天不必同时做好所有事，先选最值得投入的一件。",
    "theme": "focus"
  },
  {
    "id": "focus_07",
    "text": "放下暂时无关的声音，让重要的事得到完整的关注。",
    "theme": "focus"
  },
  {
    "id": "focus_08",
    "text": "专注可以从关掉一个多余的窗口开始。",
    "theme": "focus"
  },
  {
    "id": "focus_09",
    "text": "把任务写得具体一点，让行动有一个清楚的落点。",
    "theme": "focus"
  },
  {
    "id": "focus_10",
    "text": "认真完成一个小段落，也值得停下来肯定自己。",
    "theme": "focus"
  },
  {
    "id": "focus_11",
    "text": "给努力留出时间，也给注意力留出休息。",
    "theme": "focus"
  },
  {
    "id": "focus_12",
    "text": "慢下来观察，你可能会发现原本忽略的细节。",
    "theme": "focus"
  },
  {
    "id": "focus_13",
    "text": "把心放回手中的事情，今天就少一份空转的担忧。",
    "theme": "focus"
  },
  {
    "id": "focus_14",
    "text": "你能控制的这一小步，值得被认真对待。",
    "theme": "focus"
  },
  {
    "id": "focus_15",
    "text": "与其反复催促自己，不妨先整理好开始需要的条件。",
    "theme": "focus"
  },
  {
    "id": "focus_16",
    "text": "每一次回到当下，都是一次重新集中力量的练习。",
    "theme": "focus"
  },
  {
    "id": "focus_17",
    "text": "重要的事情不一定需要很快，但需要真正开始。",
    "theme": "focus"
  },
  {
    "id": "focus_18",
    "text": "允许外界热闹，也允许自己安静地做完这一件事。",
    "theme": "focus"
  },
  {
    "id": "focus_19",
    "text": "在忙碌之间留一点停顿，看看接下来真正需要做什么。",
    "theme": "focus"
  },
  {
    "id": "focus_20",
    "text": "一段不被打扰的练习，会让你更看得清自己的问题。",
    "theme": "focus"
  },
  {
    "id": "focus_21",
    "text": "少一点同时进行，多一点完整地完成。",
    "theme": "focus"
  },
  {
    "id": "focus_22",
    "text": "当事情太多时，先给它们排一个能够执行的顺序。",
    "theme": "focus"
  },
  {
    "id": "focus_23",
    "text": "把今天的注意力，留给最能推动你向前的那件事。",
    "theme": "focus"
  },
  {
    "id": "focus_24",
    "text": "先做好可以判断的部分，再慢慢处理还不清楚的部分。",
    "theme": "focus"
  },
  {
    "id": "focus_25",
    "text": "安静不是没有进展，有时它正是认真工作的声音。",
    "theme": "focus"
  },
  {
    "id": "focus_26",
    "text": "开始之前深呼吸一次，让心和手一起回到现在。",
    "theme": "focus"
  },
  {
    "id": "focus_27",
    "text": "给自己设一个小终点，完成之后好好休息。",
    "theme": "focus"
  },
  {
    "id": "focus_28",
    "text": "不必追着每一种声音走，你可以选择自己的关注。",
    "theme": "focus"
  },
  {
    "id": "focus_29",
    "text": "耐心看完一个问题，比匆忙跳过更接近理解。",
    "theme": "focus"
  },
  {
    "id": "focus_30",
    "text": "愿你在专注的片刻里，感到自己正在踏实地生活。",
    "theme": "focus"
  },
  {
    "id": "action_01",
    "text": "从能够做到的那一步开始，让想法慢慢变成现实。",
    "theme": "action"
  },
  {
    "id": "action_02",
    "text": "今天先做五分钟，也比一直等准备完美更接近开始。",
    "theme": "action"
  },
  {
    "id": "action_03",
    "text": "把愿望写成一件具体的小事，然后给它一个时间。",
    "theme": "action"
  },
  {
    "id": "action_04",
    "text": "你不必先有完整的路线，先走到下一个清楚的路口。",
    "theme": "action"
  },
  {
    "id": "action_05",
    "text": "一个小小的完成，会让下一次开始多一点底气。",
    "theme": "action"
  },
  {
    "id": "action_06",
    "text": "把计划放到日程里，给它一个真正发生的机会。",
    "theme": "action"
  },
  {
    "id": "action_07",
    "text": "想改变的时候，先挑一件今天可以动手的事。",
    "theme": "action"
  },
  {
    "id": "action_08",
    "text": "先整理需要的工具，再给开始留出十分钟。",
    "theme": "action"
  },
  {
    "id": "action_09",
    "text": "行动可以很轻，小到发出一条认真准备好的消息。",
    "theme": "action"
  },
  {
    "id": "action_10",
    "text": "把第一步做得容易一点，你就更有机会迈出它。",
    "theme": "action"
  },
  {
    "id": "action_11",
    "text": "今天写下第一行，明天便有了可以继续的地方。",
    "theme": "action"
  },
  {
    "id": "action_12",
    "text": "与其反复担心做不好，不妨先做一个能够修改的版本。",
    "theme": "action"
  },
  {
    "id": "action_13",
    "text": "想法值得被记录，也值得被带到真实的生活里试一试。",
    "theme": "action"
  },
  {
    "id": "action_14",
    "text": "把想去的远方，连接到今天能够安排的一次练习。",
    "theme": "action"
  },
  {
    "id": "action_15",
    "text": "你可以先尝试，再根据看到的结果调整。",
    "theme": "action"
  },
  {
    "id": "action_16",
    "text": "不必把一切同时改变，先让一个小习惯发生。",
    "theme": "action"
  },
  {
    "id": "action_17",
    "text": "一个具体的开始，能让模糊的目标变得清楚一些。",
    "theme": "action"
  },
  {
    "id": "action_18",
    "text": "认真做一次，比在心里反复演练更容易获得反馈。",
    "theme": "action"
  },
  {
    "id": "action_19",
    "text": "给计划一个小期限，也给自己一个合理的起点。",
    "theme": "action"
  },
  {
    "id": "action_20",
    "text": "从书签里选一页开始读，从清单里选一项开始做。",
    "theme": "action"
  },
  {
    "id": "action_21",
    "text": "当任务显得太大，先找到能够独立完成的一小块。",
    "theme": "action"
  },
  {
    "id": "action_22",
    "text": "让今天留下一点可见的进展，哪怕只是一段草稿。",
    "theme": "action"
  },
  {
    "id": "action_23",
    "text": "行动之后记下感受，你会更懂得接下来怎样继续。",
    "theme": "action"
  },
  {
    "id": "action_24",
    "text": "先把下一步需要的东西准备好，让明天更容易出发。",
    "theme": "action"
  },
  {
    "id": "action_25",
    "text": "把犹豫拆成问题，再逐个寻找可以验证的答案。",
    "theme": "action"
  },
  {
    "id": "action_26",
    "text": "你可以边走边修正，不需要把每一步都提前猜对。",
    "theme": "action"
  },
  {
    "id": "action_27",
    "text": "给真正想做的事，留一个不会被随意挤掉的时间。",
    "theme": "action"
  },
  {
    "id": "action_28",
    "text": "今天完成的小步骤，会成为下一段路的起点。",
    "theme": "action"
  },
  {
    "id": "action_29",
    "text": "把能做的事情做起来，让反馈帮你找到更好的方向。",
    "theme": "action"
  },
  {
    "id": "action_30",
    "text": "愿你带着自己的节奏，把心中的愿望一步步带进生活。",
    "theme": "action"
  }
]
